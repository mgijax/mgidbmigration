#!/bin/csh -f

#
# delete annotations to the old J:259852
#

setenv ANNOTDATADIR	${DBUTILS}/mgidbmigration/strainmarker
setenv ANNOTMODE	delete
setenv ANNOTTYPENAME	"MCV/StrainMarker"
setenv DELETEREFERENCE  "J:259852"
setenv DELETEUSER	none
setenv ANNOTOBSOLETE	0
setenv ANNOTINPUTFILE   ${DBUTILS}/mgidbmigration/strainmarker/mgp_annotloaddelete.txt
setenv ANNOTLOG		${DBUTILS}/mgidbmigration/strainmarker/mgp_annotloaddelete.log

